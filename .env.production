# ============================================
# WorkBridge - Production Environment Variables
# ============================================
# Copy this file to .env and change the values below.
# NEVER commit .env to git (it's already in .gitignore).

# MySQL
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_USER=wb_user
MYSQL_PASSWORD=change_me_db_password

# MongoDB
MONGO_USER=mongo_admin
MONGO_PASSWORD=change_me_mongo_password

# Flask Backend
SECRET_KEY=change_me_to_a_64_char_random_string
