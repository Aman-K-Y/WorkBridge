# Environment Configuration Example
# Copy this file to .env and fill in your real values.
# Never commit the actual .env file to GitHub.

# --- Application Environment ---
FLASK_ENV=development

# --- Security & Auth ---
# Must be at least 32 characters in production
SECRET_KEY=change-this-to-a-random-secret-string-in-production
# Used for verifying requests to the matching service
MATCHING_SERVICE_TOKEN=internal-shared-secret-change-this

# --- MySQL Database ---
MYSQL_USER=workbridge_user
MYSQL_PASSWORD=change-this-password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=workbridge

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=workbridge

# --- Service URLs ---
MATCHING_SERVICE_URL=http://localhost:8081
API_BASE_URL=http://localhost:5000/api

# --- PHP Frontend ---
SESSION_COOKIE_SECURE=0
CORS_ORIGINS=http://localhost,http://127.0.0.1
